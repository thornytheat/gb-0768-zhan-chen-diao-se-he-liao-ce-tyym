<section class="panel receipt-sheet signed"><div class="receipt-head"><div><p>工坊留存联</p><h2>调色收据证据</h2></div><strong>{{ meta.order }}</strong></div>{% if receipt %}<p>按成分勾稽差额 <b>{{ grams(receipt.mass_check_mg) }} g</b></p><p>摘要 <code>{{ receipt.sha256 }}</code></p><div class="stub"><a href="{{ url_for('palette.export',key=key) }}">下载证据收据</a> · <a href="{{ url_for('palette.outward',key=key) }}">签发外发联</a></div>{% else %}<p>请先封存工单。</p>{% endif %}</section>{% if outward %}<section class="panel folio"><h2>外发联预览</h2><p>采购批号与称量原件仅内审可见；外发料号仅在本收据内可比同批料，跨工单不可串联。签章 <code>{{ outward.seal }}</code></p><div class="scroll"><table><thead><tr><th>外发料号</th><th>回桶 g</th><th>申报 g</th><th>差异 g</th><th>对账</th></tr></thead><tbody>{% for m in outward.materials %}<tr><th scope="row"><code>{{ m.material }}</code></th><td>{{ grams(m.returned_mg) }}</td><td>{{ grams(m.claimed_mg) }}</td><td class="{{ 'difference' if m.difference_mg else '' }}">{{ grams(m.difference_mg) }}</td><td>{{ labels[m.code] }}</td></tr>{% else %}<tr><td colspan="5">暂无回桶记录。</td></tr>{% endfor %}</tbody></table></div></section>{% endif %}<section class="panel folio"><h2>签发成分清单</h2>{% include 'balances.j2' %}</section>
